---
layout: base
title: "Saheb Ansari - Modern Thoughts on Web & Tech"
pageType: home
description: "A modern personal blog featuring thoughts on web development, technology, and creative ideas."
---

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <div class="hero-content-wrapper">
            <div class="hero-content">
                <h1 class="hero-title">Learn . Build . Share</h1>
                <p class="hero-subtitle">
                    Welcome to my digital garden—a curated collection of
                    tutorials, insights, and experiments from my engineering journey. 
                    Learn about web development, software architecture, and the art of building
                    maintainable systems.
                </p>
                <div class="hero-actions">
                    <a href="/blog/" class="btn btn--primary btn--lg">Explore Articles</a>
                    <a href="/about/" class="btn btn--secondary btn--lg">About Me</a>
                </div>
            </div>
            
            <!-- TerraPDF Promo Banner -->
            <div class="hero-promo">
                <div class="promo-card">
                    <div class="promo-header">
                        <img src="https://github.com/sahebansari/TerraPDF/raw/master/logo.png" 
                             alt="TerraPDF Logo" 
                             class="promo-logo">
                        <span class="promo-badge">Open Source</span>
                    </div>
                    <h3 class="promo-title">TerraPDF</h3>
                    <p class="promo-description">
                        Zero-dependency PDF generation for .NET. 
                        MIT licensed, fluent API, production-ready.
                    </p>
                    <a href="https://www.nuget.org/packages/TerraPDF/" 
                       target="_blank" 
                       rel="noopener noreferrer" 
                       class="btn btn--sm btn--accent">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Get from NuGet
                    </a>
                    <div class="promo-features">
                        <span class="promo-feature">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            Zero dependencies
                        </span>
                        <span class="promo-feature">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            MIT License
                        </span>
                        <span class="promo-feature">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            .NET 8+ ready
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Latest Posts Section -->
<section id="posts" class="section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Latest Posts</h2>
            <p class="section-description">
                Explore the newest articles on web development, architecture, and engineering practices.
            </p>
        </div>

        <div class="posts-grid">
            {%- for post in collections.posts.slice(0, 6) -%}
            {% set postCardClass = "post-card fade-in" %}
            {% set delayClass = " delay-" + (loop.index0 * 100)|string %}
            {% include "post-card.njk" %}
            {%- endfor -%}
        </div>

        <div class="section-actions" style="text-align: center; margin-top: var(--space-12);">
            <a href="/blog/" class="btn btn--primary btn--lg">View all posts</a>
        </div>
    </div>
</section>
