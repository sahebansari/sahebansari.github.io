<!DOCTYPE html>
<html lang="en">
<head>
    {% set siteUrl = "https://sahebansari.com" %}
    {% set siteName = "Saheb Ansari" %}
    {% set metaDescription = description or excerpt or 'Welcome to my blog-a space where knowledge meets curiosity!' %}
    {% set socialImage = ogImage or image or '/assets/images/logo.svg' %}
    {% set socialImageUrl = socialImage | absoluteUrl %}
    {% set pageTitle = title if pageType == 'home' else title + ' - ' + siteName %}
    {% set schemaType = 'BlogPosting' if pageType == 'post' or layout == 'post' else 'WebPage' %}
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="/assets/images/favicon.ico" type="image/x-icon">
    <!-- Favicon -->
    <link rel="icon" href="/assets/images/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/assets/images/favicon.ico" sizes="any">

    <!-- Primary Meta Tags -->
    <title>{{ pageTitle }}</title>
    <meta name="title" content="{{ pageTitle }}">
    <meta name="description" content="{{ metaDescription }}">
    <meta name="author" content="{{ author or siteName }}">
    <meta name="keywords" content="{{ category or 'blog,software engineering,web development,ASP.NET Core,architecture' }}">
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <meta name="bingbot" content="index, follow">
    <meta name="language" content="English">
    <meta name="revisit-after" content="7 days">
    <meta name="rating" content="General">
    <meta name="distribution" content="global">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="format-detection" content="telephone=no">
    <meta name="HandheldFriendly" content="true">
    <meta name="MobileOptimized" content="320">
    <meta name="generator" content="Eleventy (https://www.11ty.dev)">

    <!-- Canonical URL (keep this early for SEO) -->
    <link rel="canonical" href="{{ siteUrl }}{{ page.url }}">

    <!-- Preconnect / DNS prefetch for performance and SEO -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="dns-prefetch" href="https://github.com">
    <link rel="dns-prefetch" href="https://picsum.photos">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{{ ogType or ('article' if schemaType == 'BlogPosting' else 'website') }}">
    <meta property="og:site_name" content="{{ siteName }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="{{ siteUrl }}{{ page.url }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:image" content="{{ socialImageUrl }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ title }}">
    {% if date %}<meta property="article:published_time" content="{{ date | htmlDateString }}">{% endif %}
    {% if date %}<meta property="article:modified_time" content="{{ date | htmlDateString }}">{% endif %}
    {% if category %}<meta property="article:section" content="{{ category }}">{% endif %}
    {% if category %}<meta property="article:tag" content="{{ category }}">{% endif %}
    {% if author %}<meta property="article:author" content="{{ author }}">{% endif %}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:site" content="@sahebansari">
    <meta property="twitter:creator" content="{{ '@sahebansari' if author else '' }}">
    <meta property="twitter:url" content="{{ siteUrl }}{{ page.url }}">
    <meta property="twitter:title" content="{{ pageTitle }}">
    <meta property="twitter:description" content="{{ metaDescription }}">
    <meta property="twitter:image" content="{{ socialImageUrl }}">
    <meta property="twitter:image:alt" content="{{ title }}">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">


    <!-- Styles -->
    <link rel="stylesheet" href="/assets/css/fluent2-tokens.css">
    <link rel="stylesheet" href="/assets/css/style.css">    

    <!-- Highlight.js CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

    <!-- Google Analytics -->
    {% if site.googleAnalyticsId and site.googleAnalyticsId != 'G-XXXXXXXXXX' %}
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-5P7BGH4MKD"></script>
        <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-5P7BGH4MKD');
        </script>
    {% endif %}

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Saheb Ansari",
        "url": "https://sahebansari.com",
        "jobTitle": "{{ authorRole or 'Software Engineer' }}",
        "sameAs": [
            "https://twitter.com/sahebansari",
            "https://github.com/sahebansari",
            "https://linkedin.com/in/sahebansari"
        ],
        "knowsAbout": [
            "ASP.NET Core",
            "Web Development",
            "C#",
            "Software Architecture",
            "Clean Code",
            "Accessibility",
            "Performance Optimization",
            "Fluent Design"
        ]
    }
    </script>

    {% if schemaType == 'BlogPosting' and date and title %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "BlogPosting",
                "headline": "{{ title }}",
                "description": "{{ metaDescription }}",
                "url": "{{ siteUrl }}{{ page.url }}",
                "datePublished": "{{ date | htmlDateString }}",
                "dateModified": "{{ date | htmlDateString }}",
                "author": {
                    "@type": "Person",
                    "name": "{{ author or siteName }}",
                    "url": "{{ siteUrl }}/about/"
                },
                "publisher": {
                    "@type": "Person",
                    "name": "{{ author or siteName }}",
                    "url": "{{ siteUrl }}/about/"
                },
                "image": {
                    "@type": "ImageObject",
                    "url": "{{ socialImageUrl }}",
                    "width": 1200,
                    "height": 630
                },
                "mainEntityOfPage": {
                    "@type": "WebPage",
                    "@id": "{{ siteUrl }}{{ page.url }}"
                },
                "keywords": "{{ category or 'software engineering,web development' }}",
                "wordCount": "{{ content | striptags | length }}",
                "inLanguage": "en-US"
            },
            {
                "@type": "WebSite",
                "name": "{{ siteName }}",
                "url": "{{ siteUrl }}",
                "potentialAction": {
                    "@type": "SearchAction",
                    "target": {
                        "@type": "EntryPoint",
                        "urlTemplate": "{{ siteUrl }}/search?q={search_term_string}"
                    },
                    "query-input": "required name=search_term_string"
                }
            }
        ]
    }
    </script>
    {% elif schemaType != 'BlogPosting' %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "{{ title }}",
        "description": "{{ metaDescription }}",
        "url": "{{ siteUrl }}{{ page.url }}",
        "isPartOf": {
            "@type": "WebSite",
            "name": "{{ siteName }}",
            "url": "{{ siteUrl }}"
        },
        "primaryImageOfPage": {
            "@type": "ImageObject",
            "url": "{{ socialImageUrl }}"
        }
    }
    </script>
    {% endif %}
    </head>

    <body class="fluent-body" data-theme="light" style="margin: 0; padding: 0;">
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <!-- Navigation -->
    <nav class="navbar" aria-label="Main navigation">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">
                <img src="/assets/images/logo.svg" alt="Saheb Ansari Logo" class="navbar-brand-logo">
                <span class="gradient-text">Saheb Ansari</span>
            </a>

            <div class="navbar-links">
                <a href="/" class="navbar-link {% if page.url == '/' %}navbar-link--active{% endif %}">Home</a>
                <a href="/blog/" class="navbar-link {% if page.url == '/blog/' %}navbar-link--active{% endif %}">Blog</a>
                <a href="/about/" class="navbar-link {% if page.url == '/about/' %}navbar-link--active{% endif %}">About</a>

                <!-- Theme Toggle -->
                <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                    <svg id="sun-icon" class="theme-toggle-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06L6.166 5.106a.75.75 0 00-1.061 1.06l1.592 1.591z"/>
                    </svg>
                    <svg id="moon-icon" class="theme-toggle-icon" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59z"/>
                    </svg>
                </button>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    {{ content | safe }}

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <div class="footer-logo">
                        <img src="/assets/images/logo.svg" alt="Saheb Ansari Logo" class="footer-logo-img">
                        <h3 class="footer-title">Saheb Ansari</h3>
                    </div>
                    <p class="footer-text">Software Engineer | Architect | Blogger</p>
                </div>
                <div>
                    <h4 class="footer-heading">Navigation</h4>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/blog/">Blog</a></li>
                        <li><a href="/about/">About</a></li>
                        <li><a href="/copyright/">Copyright</a></li>
                        <li><a href="/privacy/">Privacy</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="footer-heading">Recent Posts</h4>
                    <ul class="footer-links">
                        {% set recentPosts = collections.posts.slice(0, 4) %}
                        {% for post in recentPosts %}
                        <li><a href="{{ post.url }}" title="{{ post.data.title }}" class="fluent-recent-post-link">{{ post.data.title | truncate(40) }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
                <div>
                    <h4 class="footer-heading">Social</h4>
                    <ul class="footer-links">
                        <li><a href="https://twitter.com/sahebansari">Twitter</a></li>
                        <li><a href="https://github.com/sahebansari">GitHub</a></li>
                        <li><a href="https://linkedin.com/in/sahebansari">LinkedIn</a></li>
                        <li><a href="https://facebook.com/sahebansari">Facebook</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="footer-heading">Contact</h4>
                    <ul class="footer-links">
                        <li><a href="mailto:me@sahebansari.com">Email</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-divider"></div>
            <div class="footer-bottom">
                <p><strong>&copy; 2026 Saheb Ansari. All rights reserved.</strong></p>
                <p>
                    <strong>Disclaimer:</strong> The views expressed on this blog are my own and do not necessarily
                    reflect the views of my employer or any affiliated organizations.
                    Any logos or company names mentioned here are used solely for reference
                    purposes and may be the trademarks or property of their respective owners.
                </p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="/assets/js/theme.js"></script>
    {% if highlightCode %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/hljs.min.js"></script>
    <script>
        // Highlight code blocks
        document.querySelectorAll('pre code').forEach(block => {
            hljs.highlightElement(block);
        });
    </script>
    {% endif %}
</body>
</html>
