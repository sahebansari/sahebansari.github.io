{
  "name": "sahebansari-blog",
  "version": "1.0.0",
  "description": "Modern personal blog with Fluent 2 design system and Eleventy",
  "main": "index.js",
  "scripts": {
    "start": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "build": "npm run clean && eleventy",
    "watch": "eleventy --watch",
    "debug": "DEBUG=Eleventy* eleventy",
    "og": "node scripts/generate-og.js"
  },
  "keywords": [
    "blog",
    "eleventy",
    "fluent2"
  ],
  "author": "Saheb Ansari",
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5"
  }
}
